# Copie para .env (chmod 600) e preencha. NUNCA commitar o .env.
# As ferramentas leem primeiro o ambiente; --env-file .env também é aceito.

# --- Palo Alto (mesmo padrão do palo-collector: a env var GUARDA a chave) ---
PA_TECE1_FW01_KEY=
PA_TECE1_FW02_KEY=

# --- FortiGate: topologia TECE1 = 2 clusters (CLIENTE .142 / INFRABASE .144) ---
# Sessão (temporário, até existir api-user read-only):
FG_TECE1_PASS=
# Tokens de API read-only (desenho definitivo, RUNBOOK §2):
FG_TECE1_CLIENTE_TOKEN=
FG_TECE1_INFRABASE_TOKEN=

# --- InfluxDB central ---
INFLUX_URL=http://10.114.35.75:8086
INFLUX_ORG=TOTVS
INFLUX_BUCKET=fw_migration
INFLUX_TOKEN=

# --- caminhos locais (fora do repo) ---
